# ==============================================================================
# Smart AI Voice Agent — Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# Default setting is 100% LOCAL-FIRST ($0 Compute).
# ==============================================================================

# --- AI PROVIDER SELECTION ---
# Options: ollama (local, default) | gemini | groq | openai
LLM_PROVIDER=ollama
# Options: faster_whisper (local, default) | deepgram | groq
STT_PROVIDER=faster_whisper
# Options: kokoro (local, default) | piper | cartesia | elevenlabs
TTS_PROVIDER=kokoro

# --- LOCAL OLLAMA CONFIGURATION (No API Key Required) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LOCAL STT & TTS SETTINGS ---
FASTER_WHISPER_MODEL=base.en
KOKORO_VOICE_ID=af_sarah
KOKORO_SPEED=1.00

# --- CLOUD AI PROVIDERS (Only required if switching from local) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# --- GATEWAY & SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# --- PERSISTENCE & DATA STORAGE ---
DATABASE_URL=sqlite:///./data/voice_agent.db
CHROMA_PERSIST_DIR=./data/chroma_db
LOG_LEVEL=INFO

# --- RAG EMBEDDINGS (local-first; no model download by default) ---
# Options: local_hash (default) | nomic_ollama | fastembed
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=nomic-embed-text

# --- WEATHER (local stub by default; Open-Meteo needs no API key) ---
# Options: stub | open_meteo
WEATHER_PROVIDER=stub
